# Session-signing secret for "npm run dev". The installed app makes its own and keeps it next to the data.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: keep the development data somewhere else than
# %LOCALAPPDATA%\net.algarvebuilders.accounts-manager
# ACCOUNTS_DATA_DIR=
